---
import Layout from '@/layouts/Layout.astro';
import ChapterSection from '@/components/chapter/ChapterSection.astro';
import LiveNowGrid from '@/components/live/LiveNowGrid.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import BilingualSpan from '@/components/ui/BilingualSpan.astro';
import GlossaryTerm from '@/components/ui/GlossaryTerm.astro';
import CosmicCalendar from '@/components/chapter/CosmicCalendar.astro';
import { CHAPTERS, CHAPTER_COUNT } from '@/content/timeline';

const [, c02, c03, c04, c05, c06, c07] = CHAPTERS;
---

<Layout
  title="Una breve historia del cosmos"
  titleEs="Una breve historia del cosmos"
  titleEn="A brief history of the cosmos"
  description="Viaje bilingüe (ES/EN) del Big Bang al presente: capítulos editoriales, Three.js, GSAP y datos en vivo de la NASA (APOD) y la ISS."
  ogTitle="Una breve historia del cosmos"
>
  <main id="main">
    <ChapterSection chapter={CHAPTERS[0]} totalChapters={CHAPTER_COUNT} variant="hero">
      <span slot="heading" data-es><span class="hero__line">Una breve</span><span class="hero__line">historia del</span><span class="hero__line hero__line--serif">cosmos.</span></span>
      <span slot="heading" data-en><span class="hero__line">A brief</span><span class="hero__line">history of the</span><span class="hero__line hero__line--serif">cosmos.</span></span>
      <BilingualSpan
        slot="lede"
        es="El universo cabía en un punto. Luego dejó de caber."
        en="The universe fit in a point. Then it didn't."
      />
      <span slot="note">
        <span data-es>En una fracción mínima de segundo, <GlossaryTerm id="inflation">el espacio se estiró</GlossaryTerm> más rápido que cualquier señal pudiera recorrerlo.</span>
        <span data-en>In a tiny fraction of a second, <GlossaryTerm id="inflation">space stretched</GlossaryTerm> faster than any signal could cross it.</span>
      </span>
      <div slot="stats">
        <dt><BilingualSpan es="Edad" en="Age" /></dt>
        <dd>10<span data-count="-32" data-count-format="exp">⁻³²</span> s</dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Expansión" en="Expansion" /></dt>
        <dd>×10<span data-count="26" data-count-format="exp">²⁶</span></dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c02} totalChapters={CHAPTER_COUNT}>
      <BilingualSpan slot="heading" es="La primera luz" en="First light" />
      <BilingualSpan
        slot="lede"
        es="380 000 años después, la luz por fin pudo viajar."
        en="380,000 years later, light could finally travel."
      />
      <span slot="note">
        <span data-es>Los electrones encontraron núcleos, el plasma se volvió transparente y quedó grabado el <GlossaryTerm id="cmb">eco térmico</GlossaryTerm> del inicio.</span>
        <span data-en>Electrons joined nuclei, plasma turned transparent, and the early <GlossaryTerm id="cmb">thermal echo</GlossaryTerm> was imprinted.</span>
      </span>
      <div slot="stats">
        <dt><BilingualSpan es="Edad" en="Age" /></dt>
        <dd>
          <span data-count="380000">380 000</span> <BilingualSpan es="años" en="years" />
        </dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Temperatura" en="Temperature" /></dt>
        <dd><span data-count="3000" data-count-from="100000">3 000</span> K</dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c03} totalChapters={CHAPTER_COUNT}>
      <BilingualSpan slot="heading" es="Las primeras estrellas" en="The first stars" />
      <BilingualSpan
        slot="lede"
        es="Encendieron una oscuridad de cien millones de años."
        en="They lit up a hundred-million-year darkness."
      />
      <BilingualSpan
        slot="note"
        es="Sus hornos breves fabricaron los primeros elementos pesados y cambiaron para siempre la química del cosmos."
        en="Their short-lived furnaces forged the first heavy elements and changed cosmic chemistry forever."
      />
      <div slot="stats">
        <dt><BilingualSpan es="Edad" en="Age" /></dt>
        <dd>~<span data-count="200">200</span> <GlossaryTerm id="ma">Ma</GlossaryTerm></dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Población" en="Population" /></dt>
        <dd><GlossaryTerm id="pop3">III</GlossaryTerm></dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c04} totalChapters={CHAPTER_COUNT}>
      <BilingualSpan slot="heading" es="Espirales lentas" en="Slow spirals" />
      <BilingualSpan
        slot="lede"
        es="La gravedad tejió a las estrellas en espirales."
        en="Gravity wove the stars into spirals."
      />
      <span slot="note">
        <span data-es>Discos, <GlossaryTerm id="halo">halos</GlossaryTerm> y brazos espirales empezaron a mezclar gas, polvo y generaciones enteras de estrellas.</span>
        <span data-en>Disks, <GlossaryTerm id="halo">halos</GlossaryTerm>, and spiral arms began mixing gas, dust, and whole generations of stars.</span>
      </span>
      <div slot="stats">
        <dt><BilingualSpan es="Edad" en="Age" /></dt>
        <dd><span data-count="1">1</span> <GlossaryTerm id="ga">Ga</GlossaryTerm></dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Vía Láctea" en="Milky Way" /></dt>
        <dd>~10<span data-count="11" data-count-format="exp">¹¹</span> ★</dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c05} totalChapters={CHAPTER_COUNT}>
      <BilingualSpan slot="heading" es="Una nube colapsa" en="A cloud collapses" />
      <BilingualSpan
        slot="lede"
        es="Una nube de polvo y gas se derrumbó. De ella salimos nosotros."
        en="A cloud of dust and gas collapsed. From it, we emerged."
      />
      <BilingualSpan
        slot="note"
        es="Alrededor del Sol joven, granos microscópicos chocaron hasta levantar mundos, lunas y océanos posibles."
        en="Around the young Sun, microscopic grains collided until they built worlds, moons, and possible oceans."
      />
      <div slot="stats">
        <dt><BilingualSpan es="Hace" en="Ago" /></dt>
        <dd><span data-count="4.6" data-count-decimals="1">4.6</span> Ga</dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Planetas" en="Planets" /></dt>
        <dd><span data-count="8">8</span></dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c06} totalChapters={CHAPTER_COUNT}>
      <BilingualSpan slot="heading" es="Química inquieta" en="Restless chemistry" />
      <span slot="lede">
        <span data-es>Una química inquieta empezó a <GlossaryTerm id="replication">copiarse a sí misma</GlossaryTerm>.</span>
        <span data-en>A restless chemistry started <GlossaryTerm id="replication">copying itself</GlossaryTerm>.</span>
      </span>
      <BilingualSpan
        slot="note"
        es="La evolución convirtió moléculas frágiles en células, ecosistemas y memorias capaces de adaptarse."
        en="Evolution turned fragile molecules into cells, ecosystems, and memories capable of adapting."
      />
      <div slot="stats">
        <dt><BilingualSpan es="Hace" en="Ago" /></dt>
        <dd><span data-count="3.7" data-count-decimals="1">3.7</span> Ga</dd>
      </div>
      <div slot="stats">
        <dt><BilingualSpan es="Especies" en="Species" /></dt>
        <dd>~10<span data-count="7" data-count-format="exp">⁷</span></dd>
      </div>
    </ChapterSection>

    <ChapterSection chapter={c07} totalChapters={CHAPTER_COUNT} variant="now">
      <BilingualSpan
        slot="heading"
        es="Trece mil ochocientos millones de años después"
        en="Thirteen-point-eight billion years later"
      />
      <BilingualSpan
        slot="lede"
        es="Una estación humana cruza el cielo cada noventa minutos. Un telescopio mira más lejos que nunca."
        en="A human station crosses the sky every ninety minutes. A telescope sees farther than ever."
      />
      <BilingualSpan
        slot="note"
        es="La historia ya no es sólo pasado: la medimos en directo con órbitas, cámaras y señales que llegan ahora mismo."
        en="The story is no longer only past tense: we measure it live through orbits, cameras, and signals arriving now."
      />
      <div slot="extra">
        <CosmicCalendar />
        <LiveNowGrid />
        <a href="/work#src-now" class="chapter__more">
          <BilingualSpan es="Fuentes y créditos →" en="Sources and credits →" />
        </a>
      </div>
    </ChapterSection>

    <SiteFooter />
  </main>
</Layout>

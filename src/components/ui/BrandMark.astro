---
// Siete arcos, uno por era, con los colores de ERA_ACCENTS; el punto central es el primer instante.
// brand-mark.ts los enciende al cargar y resalta el arco del capítulo activo.
import { CHAPTERS } from '@/content/timeline';
import { ERA_ACCENTS } from '@/scripts/three/era-presets';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const RADIUS = 14;
const STROKE = 2.6;
const gapDeg = (((STROKE + 1.6) / RADIUS) * 180) / Math.PI;
const span = 360 / CHAPTERS.length;
const point = (deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return `${(20 + RADIUS * Math.cos(rad)).toFixed(2)} ${(20 + RADIUS * Math.sin(rad)).toFixed(2)}`;
};
const arcs = CHAPTERS.map((chapter, i) => ({
  d: `M${point(-90 + i * span + gapDeg / 2)}A${RADIUS} ${RADIUS} 0 0 1 ${point(-90 + (i + 1) * span - gapDeg / 2)}`,
  color: ERA_ACCENTS[chapter.era],
  id: chapter.id,
}));
---

<svg class:list={['brand-mark', className]} viewBox="0 0 40 40" fill="none" aria-hidden="true" data-brand-mark>
  <g stroke-width={STROKE} stroke-linecap="round">
    {arcs.map((arc) => <path class="brand-mark__arc" d={arc.d} stroke={arc.color} style={`--arc-color: ${arc.color}`} data-chapter={arc.id} />)}
  </g>
  <circle class="brand-mark__dot" cx="20" cy="20" r="2.2" fill="#f0ebe1" />
</svg>

<article class="live-card live-card--iss" data-iss>
  <header>
    <span class="live-card__kicker">
      <span data-es>ISS · en vivo</span><span data-en>ISS · live</span>
    </span>
    <h3>
      <span data-es>Estación Espacial Internacional</span><span data-en>International Space Station</span>
    </h3>
  </header>
  <canvas class="iss-globe" data-iss-canvas aria-label="ISS globe visualization"></canvas>
  <dl class="iss-data">
    <div>
      <dt><span data-es>Latitud</span><span data-en>Latitude</span></dt>
      <dd data-iss-lat>—</dd>
    </div>
    <div>
      <dt><span data-es>Longitud</span><span data-en>Longitude</span></dt>
      <dd data-iss-lon>—</dd>
    </div>
    <div>
      <dt><span data-es>Altitud</span><span data-en>Altitude</span></dt>
      <dd data-iss-alt>—</dd>
    </div>
    <div>
      <dt><span data-es>Velocidad</span><span data-en>Velocity</span></dt>
      <dd data-iss-vel>—</dd>
    </div>
  </dl>
</article>

---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import MainNav from '@/components/nav/MainNav.astro';
import EraRail from '@/components/nav/EraRail.astro';
import EraMobileNav from '@/components/nav/EraMobileNav.astro';

interface Props {
  title?: string;
  titleEs?: string;
  titleEn?: string;
  description?: string;
  /** Ruta o URL absoluta de la imagen para Open Graph / Twitter (recomendado ≥1200×630; PNG/JPG suele ir mejor que SVG en Meta/WhatsApp). */
  image?: string;
  ogTitle?: string;
  /** Nombre corto del sitio para og:site_name */
  siteName?: string;
  /** og:type; por defecto website */
  ogType?: string;
  robots?: string;
}

const {
  title = 'A brief history of the cosmos',
  titleEs = title,
  titleEn = title,
  description = 'A bilingual cinematic journey from the Big Bang to today, with live data from NASA APOD and the ISS.',
  image = '/og-image.svg',
  ogTitle,
  siteName = 'Una breve historia del cosmos',
  ogType = 'website',
  robots = 'index, follow',
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
function toAbsolute(href: string): string {
  if (href.startsWith('http://') || href.startsWith('https://')) return href;
  return new URL(href.startsWith('/') ? href : `/${href}`, baseUrl).href;
}
const ogImageUrl = toAbsolute(image);
const shareTitle = ogTitle ?? title;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: canonicalURL.href,
  description,
};
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Adalberto Moreno Cárdenas" />
    <meta name="theme-color" content="#06060d" />
    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={shareTitle} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="cosmos-title-es" content={titleEs} />
    <meta name="cosmos-title-en" content={titleEn} />
    <script is:inline>
      (function () {
        function readPageTitles() {
          const es = document.querySelector('meta[name="cosmos-title-es"]')?.getAttribute('content');
          const en = document.querySelector('meta[name="cosmos-title-en"]')?.getAttribute('content');
          return { es: es ?? '', en: en ?? '' };
        }
        function syncTitle() {
          const lang = document.documentElement.dataset.lang === 'en' ? 'en' : 'es';
          const { es: titleEs, en: titleEn } = readPageTitles();
          if (titleEs || titleEn) {
            document.title = lang === 'en' ? titleEn || titleEs : titleEs || titleEn;
          }
        }
        syncTitle();
        document.addEventListener('cosmos:language-change', syncTitle);
        document.addEventListener('astro:page-load', syncTitle);
      })();
    </script>
    <ClientRouter />
    <script is:inline>
      // Idioma: localStorage gana sobre el HTML del SSR. Tras View Transitions el
      // documento nuevo vuelve a traer data-lang="es"; hay que re-aplicar la preferencia.
      (function () {
        function applySavedLang() {
          try {
            const saved = localStorage.getItem('lang');
            const next =
              saved === 'en' || saved === 'es'
                ? saved
                : navigator.language?.startsWith('en')
                  ? 'en'
                  : 'es';
            const cur = document.documentElement.getAttribute('data-lang');
            if (cur === next) return;
            document.documentElement.setAttribute('lang', next);
            document.documentElement.setAttribute('data-lang', next);
            document.dispatchEvent(
              new CustomEvent('cosmos:language-change', { detail: { lang: next } }),
            );
          } catch {}
        }
        applySavedLang();
        if (!window.__cosmosLangSwapBound) {
          window.__cosmosLangSwapBound = true;
          document.addEventListener('astro:after-swap', applySavedLang);
        }
      })();
    </script>
    <script>
      import { initAnimations } from '@/scripts/animations';

      async function bootCosmos() {
        const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
        let sceneApi = window.__sceneApi ?? null;
        if (canvas && !canvas.dataset.booted) {
          const { initThreeScene } = await import('@/scripts/three/scene');
          sceneApi = initThreeScene(canvas);
          canvas.dataset.booted = '1';
          window.__sceneApi = sceneApi;
        }
        initAnimations({ sceneApi });
      }

      if (!window.__cosmosPageLoadBound) {
        window.__cosmosPageLoadBound = true;
        document.addEventListener('astro:page-load', bootCosmos);
        document.addEventListener('DOMContentLoaded', bootCosmos, { once: true });
      }
      if (document.readyState !== 'loading') bootCosmos();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      <span data-es>Saltar al contenido</span><span data-en>Skip to content</span>
    </a>
    <canvas class="bg-canvas" id="bg-canvas" aria-hidden="true" transition:persist></canvas>
    <MainNav />
    <div class="scroll-progress" aria-hidden="true"><span /></div>
    <div class="section-index" aria-hidden="true">
      <span class="section-index__num">00</span>
      <span class="section-index__label">Idle</span>
    </div>
    <EraRail />
    <EraMobileNav />
    <slot />
  </body>
</html>
